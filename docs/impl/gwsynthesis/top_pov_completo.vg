module sistema_hall_top (
  clk_d,
  reset_d,
  sensor_eh_d,
  ff2,
  anterior,
  tick_1_4_Z
)
;
input clk_d;
input reset_d;
input sensor_eh_d;
output ff2;
output anterior;
output tick_1_4_Z;
wire periodo_valido_Z;
wire inicio_vuelta_Z;
wire [31:8] periodo_total_Z;
wire VCC;
wire GND;
  medidor_periodo_efecto_hall medidor (
    .clk_d(clk_d),
    .reset_d(reset_d),
    .sensor_eh_d(sensor_eh_d),
    .ff2(ff2),
    .anterior(anterior),
    .periodo_valido_Z(periodo_valido_Z),
    .inicio_vuelta_Z(inicio_vuelta_Z),
    .periodo_total_Z(periodo_total_Z[31:8])
);
  generador_pulso_paso generador (
    .clk_d(clk_d),
    .reset_d(reset_d),
    .inicio_vuelta_Z(inicio_vuelta_Z),
    .periodo_valido_Z(periodo_valido_Z),
    .anterior(anterior),
    .ff2(ff2),
    .periodo_total_Z(periodo_total_Z[31:8]),
    .tick_1_4_Z(tick_1_4_Z)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* sistema_hall_top */
