// indican la frecuencia del reloj que utiliza nuestro código Verilog.
// codigo nerado por IA chatgpt
# Tang Nano 9K - Reloj con persistencia de vision
# Top: top_pov_completo
# Oscilador de la FPGA: 27 MHz (T = 37.037 ns)
create_clock -name clk -period 37.037 -waveform {0.000 18.5185} [get_ports {clk}]
